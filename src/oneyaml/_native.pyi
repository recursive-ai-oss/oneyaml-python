from typing import Any

from ._limits import Limits

BACKEND: str
ENGINE_VERSION: str

def probe(data: bytes) -> bool: ...
def load(data: str | bytes, limits: Limits, multi: bool, schema: str = "core") -> Any: ...
def events_text(data: str | bytes) -> list[str]: ...
def _parse_only(data: str | bytes) -> int: ...
def _panic_probe() -> None: ...
def _test_hook(what: int) -> None: ...

class Handle:
    encoding: str
    def emit(self) -> bytes: ...
    def count(self) -> int: ...
    def version(self) -> int: ...
    def kind(self, d: int, path: list[Any]) -> str: ...
    def value(self, d: int, path: list[Any]) -> Any: ...
    def length(self, d: int, path: list[Any]) -> int: ...
    def keys(self, d: int, path: list[Any]) -> list[Any]: ...
    def info(
        self, d: int, path: list[Any]
    ) -> tuple[str, str | None, str | None, str | None, int | None, int | None]: ...
    def set(self, d: int, path: list[Any], value: Any) -> None: ...
    def insert(self, d: int, path: list[Any], index: int, value: Any) -> None: ...
    def remove(self, d: int, path: list[Any]) -> None: ...
    def patch(self, d: int, ops: Any) -> None: ...
    def merge_patch(self, d: int, patch: Any) -> None: ...
    def pointer(self, d: int, pointer: str) -> bool: ...

def parse(data: str | bytes, limits: Limits) -> Handle: ...
